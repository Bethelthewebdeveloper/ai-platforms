PORT=4000

# Required by the ZEN assistant service
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_VISION_MODEL=
AI_GATEWAY_IMAGE_MODEL=openai/gpt-image-2
AI_GATEWAY_VIDEO_MODEL=google/veo-3.1-fast-generate-001
AI_GATEWAY_SPEECH_MODEL=openai/gpt-4o-mini-tts
# ZEN media token charges can be adjusted for your plans/provider costs
AI_IMAGE_GENERATION_TOKENS=1000
AI_VIDEO_GENERATION_TOKENS=5000
AI_SPEECH_GENERATION_TOKENS=100

MONGODB_URI=mongodb://127.0.0.1:27017/businessgrowth

JWT_SECRET=

# AI plans and customer API keys (editable defaults)
AI_FREE_MONTHLY_TOKENS=20000
AI_PRO_MONTHLY_TOKENS=250000
AI_PRO_PRICE_KOBO=990000
AI_PRO_MAX_API_KEYS=3
AI_PRO_KEY_LIFETIME_DAYS=7
AI_PRO_KEY_TOKEN_LIMIT=50000
AI_BUSINESS_MONTHLY_TOKENS=1000000
AI_BUSINESS_PRICE_KOBO=4990000
AI_BUSINESS_MAX_API_KEYS=10
AI_BUSINESS_KEY_LIFETIME_DAYS=30
AI_BUSINESS_KEY_TOKEN_LIMIT=250000
AI_TOKEN_PACK_TOKENS=100000
AI_TOKEN_PACK_PRICE_KOBO=499000

# Paystack: keep the secret server-side. Plan codes come from your Paystack dashboard.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PRO_PLAN_CODE=
PAYSTACK_BUSINESS_PLAN_CODE=
PAYSTACK_CALLBACK_URL=http://localhost:4000/billing/return
